third_party/face-parsing.PyTorch/
*.log
.DS_Store
wandb/
outputs/
data/raw/
# B1 impersonation stills stay on the AutoDL filesystem. Do not vendor CelebA/LFW.
assets/targets/*
!assets/targets/.gitkeep
